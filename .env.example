# Joineazy Sprint 1 - Environment Configuration

# Database Configuration
# Supported PostgreSQL connection URL (e.g., Supabase / Neon / Local Docker)
DATABASE_URL="postgresql://user:password@localhost:5432/joineazy?schema=public"

# Server Configuration
PORT=5000
NODE_ENV="development"
CLIENT_ORIGIN="http://localhost:5173"

# JWT Authentication
JWT_ACCESS_SECRET="replace-with-a-secure-random-access-secret-minimum-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="replace-with-a-secure-random-refresh-secret-minimum-32-chars"
JWT_REFRESH_EXPIRY="7d"

# Cookie Security
COOKIE_SECRET="replace-with-a-secure-cookie-secret"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
